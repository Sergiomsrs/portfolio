---
import Layout from "@/layouts/Layout.astro";

import AboutMe from "@/components/AboutMe.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Experience from "@/components/Experience.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import Projects from "@/components/Projects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import SocialPill from "@/components/SocialPill.astro";
import VerDemo from "@/components/VerDemo.astro";
import Bento from "@/components/Bento.astro";
import Trayectoria from "@/components/icons/Trayectoria.astro";
import Grid from "@/components/Grid.astro";
import Demo from "@/components/icons/Demo.astro";
import Skills from "@/components/Skills.astro";
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Sergio Méndez | Desarrollador de Software"
  description="Portfolio de Sergio Méndez - Desarrollador de Software especializado en React, Java y Spring Boot. Proyectos Full Stack y soluciones web."
>
  <main>
    <!-- Hero -->
    <SectionContainer id="contacto" class="pt-32 md:pt-40 pb-16">
      <div class="space-y-6">
        <div class="space-y-4 animate-on-scroll">
          <p
            class="text-sm font-semibold text-primary-600 dark:text-primary-400 tracking-wider uppercase"
          >
            Desarrollador de Software
          </p>
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold text-surface-900 dark:text-surface-100 leading-tight"
          >
            Construyo experiencias
            <span class="text-primary-600 dark:text-primary-400">
              web modernas</span
            >
          </h1>
          <p
            class="text-lg md:text-xl text-surface-600 dark:text-surface-400 max-w-2xl leading-relaxed"
          >
            Full Stack Developer especializado en <strong
              class="text-surface-900 dark:text-surface-100">React</strong
            >,
            <strong class="text-surface-900 dark:text-surface-100">Java</strong>
            y
            <strong class="text-surface-900 dark:text-surface-100"
              >Spring Boot</strong
            >. Transformo ideas en aplicaciones web rápidas, escalables y bien
            diseñadas.
          </p>
        </div>

        <nav class="flex gap-4 flex-wrap animate-on-scroll">
          <SocialPill
            href="https://www.linkedin.com/in/sergio-mendez-soler-03902aa5/"
          >
            <LinkedInIcon class="size-4" />
            LinkedIn
          </SocialPill>
          <SocialPill href="https://github.com/sergiomsrs">
            <GitHubIcon class="size-4" />
            GitHub
          </SocialPill>
          <SocialPill href="mailto:sergiomsrs@gmail.com">
            <MailIcon class="size-4" />
            Contacto
          </SocialPill>
        </nav>

        <div class="flex gap-4">
          <VerDemo href="#proyectos"> Ver proyectos </VerDemo>
        </div>
      </div>
    </SectionContainer>

    <!-- Proyectos -->
    <SectionContainer id="proyectos" class="py-16 md:py-24">
      <div class="space-y-12">
        <div class="space-y-2 animate-on-scroll">
          <h2
            class="text-3xl font-bold text-surface-900 dark:text-surface-100 flex items-center gap-3"
          >
            <CodeIcon class="size-8 text-primary-600 dark:text-primary-400" />
            Proyectos
          </h2>
          <p class="text-surface-600 dark:text-surface-400">
            Una selección de mis trabajos más recientes y destacados.
          </p>
        </div>

        <div class="space-y-16">
          <div class="animate-on-scroll">
            <Projects
              title="WorkSchedFlow"
              description="Aplicación web para la gestión de turnos de trabajo. Diseñada para facilitar la planificación de horarios cumpliendo normativas laborales, con interfaz intuitiva para gestores de equipos."
              image=`${base}workschedflow.webp`
              imageAlt="Captura de pantalla del proyecto WorkSchedFlow"
            />
            <div class="flex gap-3 mt-6 flex-wrap">
              <VerDemo
                href="https://sergiomsrs.github.io/prueba-concepto-gestorTurnos/"
              >
                <Demo class="size-4" />
                Demo
              </VerDemo>
              <SocialPill
                href="https://github.com/Sergiomsrs/prueba-concepto-gestorTurnos"
              >
                <GitHubIcon class="size-4" />
                UI
              </SocialPill>
              <SocialPill
                href="https://github.com/Sergiomsrs/jobhourapp-poc-api"
              >
                <GitHubIcon class="size-4" />
                API
              </SocialPill>
            </div>
          </div>

          <div class="animate-on-scroll">
            <Projects
              title="MyRecipes"
              description="Aplicación Full Stack para gestión y versionado de recetas personales. Permite documentar la evolución de cada receta con un sistema de versiones, construida con React, TypeScript, Spring Boot y PostgreSQL."
              image=`${base}my-recipes.webp`
              imageAlt="Captura de pantalla del proyecto MyRecipes"
            />
            <div class="flex gap-3 mt-6 flex-wrap">
              <VerDemo href="https://sergiomsrs.github.io/MyRecipes/">
                <Demo class="size-4" />
                Demo
              </VerDemo>
              <SocialPill href="https://github.com/Sergiomsrs/MyRecipes">
                <GitHubIcon class="size-4" />
                Código
              </SocialPill>
            </div>
          </div>

          <div class="animate-on-scroll">
            <Projects
              title="MyClass360"
              description="Sistema integral para la gestión de alumnos, clases y tareas para profesores. Incluye herramientas como generador de sopas de letras personalizadas, construido con Angular."
              image=`${base}my-class-360-landing.webp`
              imageAlt="Captura de pantalla del proyecto MyClass360"
            />
            <div class="flex gap-3 mt-6 flex-wrap">
              <VerDemo
                href="https://sergiomsrs.github.io/MyClass360-AngularUI/"
              >
                <Demo class="size-4" />
                Demo
              </VerDemo>
              <SocialPill
                href="https://github.com/Sergiomsrs/MyClass360-AngularUI"
              >
                <GitHubIcon class="size-4" />
                Código
              </SocialPill>
            </div>
          </div>

          <div class="animate-on-scroll">
            <Projects
              title="TimeTrack"
              description="Sistema de control horario de empleados. Aplicación web para el registro de fichajes y gestión de supervisión, con interfaz intuitiva para empleados y administradores."
              image="timeTrack.webp"
              imageAlt="Captura de pantalla del proyecto TimeTrack"
            />
            <div class="flex gap-3 mt-6 flex-wrap">
              <SocialPill href="https://github.com/Sergiomsrs/timetrack-ui">
                <GitHubIcon class="size-4" />
                UI
              </SocialPill>
              <SocialPill href="https://github.com/Sergiomsrs/timetrack-api">
                <GitHubIcon class="size-4" />
                API
              </SocialPill>
            </div>
          </div>

          <div class="animate-on-scroll">
            <Projects
              title="Training App"
              description="Aplicación en desarrollo para la creación y gestión de entrenamientos. Construida con React, Java, Spring Boot, MySQL y MongoDB para la gestión de usuarios y análisis de datos."
            />
            <Grid />
            <div class="flex gap-3 mt-6 flex-wrap">
              <SocialPill href="https://github.com/Sergiomsrs/app-training-v.0">
                <GitHubIcon class="size-4" />
                App
              </SocialPill>
              <SocialPill href="https://github.com/Sergiomsrs/Wod-Api--Shared">
                <GitHubIcon class="size-4" />
                Workout API
              </SocialPill>
              <SocialPill
                href="https://github.com/Sergiomsrs/Usersapp-Api--Shared"
              >
                <GitHubIcon class="size-4" />
                Users API
              </SocialPill>
            </div>
          </div>
        </div>
      </div>
    </SectionContainer>

    <!-- Habilidades -->
    <SectionContainer id="habilidades" class="py-16 md:py-24">
      <div class="space-y-8">
        <div class="space-y-2 animate-on-scroll">
          <h2 class="text-3xl font-bold text-surface-900 dark:text-surface-100">
            Habilidades
          </h2>
          <p class="text-surface-600 dark:text-surface-400">
            Tecnologías y herramientas con las que trabajo.
          </p>
        </div>
        <div class="animate-on-scroll">
          <Skills />
        </div>
      </div>
    </SectionContainer>

    <!-- Trayectoria -->
    <SectionContainer id="trayectoria" class="py-16 md:py-24">
      <div class="space-y-8">
        <div class="space-y-2 animate-on-scroll">
          <h2
            class="text-3xl font-bold text-surface-900 dark:text-surface-100 flex items-center gap-3"
          >
            <Trayectoria
              class="size-8 text-primary-600 dark:text-primary-400"
            />
            Trayectoria
          </h2>
          <p class="text-surface-600 dark:text-surface-400">
            Mi formación y evolución profesional.
          </p>
        </div>
        <div class="animate-on-scroll">
          <Experience />
        </div>
      </div>
    </SectionContainer>

    <!-- Sobre mí -->
    <SectionContainer id="sobre-mi" class="py-16 md:py-24">
      <div class="space-y-8">
        <div class="space-y-2 animate-on-scroll">
          <h2
            class="text-3xl font-bold text-surface-900 dark:text-surface-100 flex items-center gap-3"
          >
            <ProfileCheck
              class="size-8 text-primary-600 dark:text-primary-400"
            />
            Sobre mí
          </h2>
          <p class="text-surface-600 dark:text-surface-400">
            Mi historia y lo que me motiva.
          </p>
        </div>
        <div class="animate-on-scroll">
          <AboutMe />
        </div>
      </div>
    </SectionContainer>
  </main>
</Layout>

<script is:inline>
  function initAnimations() {
    const elements = document.querySelectorAll(".animate-on-scroll");

    if (!("IntersectionObserver" in window)) {
      elements.forEach((el) => el.classList.add("visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: "0px 0px -20px 0px" },
    );

    elements.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) {
        el.classList.add("visible");
      } else {
        observer.observe(el);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initAnimations);
  document.addEventListener("astro:page-load", initAnimations);
</script>
