---
const SKILLS = [
  {
    category: "Frontend",
    items: ["React", "Angular", "JavaScript", "TypeScript", "Tailwind CSS", "HTML/CSS"],
  },
  {
    category: "Backend",
    items: ["Java", "Spring Boot", "Node.js"],
  },
  {
    category: "Databases",
    items: ["MySQL", "PostgreSQL", "MongoDB"],
  },
  {
    category: "DevOps & Tools",
    items: ["Docker", "Git", "GitHub Actions"],
  },
]
---

<div class="animate-on-scroll grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
  {
    SKILLS.map((group) => (
      <div>
        <h3 class="mb-4 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
          {group.category}
        </h3>
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="cursor-default rounded-full border border-line/10 px-3 py-1.5 text-[13px] text-muted transition-colors duration-200 hover:border-accent/40 hover:text-foreground">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
