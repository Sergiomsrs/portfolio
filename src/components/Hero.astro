---
import LinkButton from "./LinkButton.astro"

const META = [
  { label: "Location", value: "Based in Spain" },
  { label: "Status", value: "Open to Work", dot: true },
  { label: "Currently Building", value: "→ MyRecipes", href: "#work" },
  { label: "Year", value: "2026" },
]
---

<section
  id="top"
  class="mx-auto w-full max-w-6xl px-6 pt-24 pb-14 md:pt-32 md:pb-20 lg:px-8"
>
  <div class="grid gap-10 lg:grid-cols-[1.7fr_1fr] lg:gap-16">
    <div class="animate-on-scroll">
      <h1
        class="text-4xl font-semibold leading-[1.05] tracking-tight text-foreground sm:text-5xl lg:text-6xl"
      >
        Sergio Méndez
      </h1>
      <p class="mt-4 text-lg font-medium text-muted md:text-xl">
        Java Backend &amp; Full Stack Developer
      </p>
      <p
        class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg"
      >
        Construyo software para resolver problemas reales de negocio.
      </p>
      <p
        class="mt-6 font-mono text-xs uppercase tracking-[0.14em] text-faint"
      >
        Java · Spring Boot · React · PostgreSQL
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <LinkButton href="#work" variant="solid">Ver proyectos</LinkButton>
        <LinkButton
          href="https://www.linkedin.com/in/sergio-mendez-soler-03902aa5/"
          variant="outline">LinkedIn ↗</LinkButton
        >
        <LinkButton href="https://github.com/sergiomsrs" variant="outline"
          >GitHub ↗</LinkButton
        >
      </div>
    </div>

    <aside
      class="animate-on-scroll lg:border-l lg:border-line/10 lg:pl-12"
      aria-label="Información contextual"
    >
      <dl>
        {
          META.map((item, i) => (
            <div
              class:list={[
                i > 0 && "mt-4 border-t border-line/10 pt-4",
              ]}
            >
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-faint">
                {item.label}
              </dt>
              <dd class="mt-1.5">
                {item.href ? (
                  <a
                    href={item.href}
                    class="font-mono text-xs uppercase tracking-[0.1em] text-foreground hover:text-accent transition-colors duration-200"
                  >
                    {item.value}
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.1em] text-foreground">
                    {item.dot && (
                      <span
                        class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-accent"
                        aria-hidden="true"
                      />
                    )}
                    {item.value}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>
