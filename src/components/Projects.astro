---
import ProjectEntry from "./ProjectEntry.astro";

const base = import.meta.env.BASE_URL;

const PROJECTS = [
  {
    n: "01",
    title: "WorkSchedFlow",
    summary:
      "Software de planificación de turnos de trabajo que cumple normativas laborales, con interfaz para gestores de equipos.",
    tech: "Java · Spring Boot · React · Timefold",
    explore: {
      label: "Demo",
      href: "https://sergiomsrs.github.io/wsf-landing/",
    },
    links: [
      {
        label: "UI",
        href: "https://github.com/Sergiomsrs/prueba-concepto-gestorTurnos",
      },
      {
        label: "API",
        href: "https://github.com/Sergiomsrs/jobhourapp-poc-api",
      },
    ],
    image: `${base}workschedflow.webp`,
    imageAlt: "Captura de pantalla del proyecto WorkSchedFlow",
  },
  {
    n: "02",
    title: "MyRecipes",
    summary:
      "Aplicación de gestión y versionado de recetas personales con evolución documentada de cada receta.",
    tech: "Java · Spring Boot · React · TypeScript · PostgreSQL",
    explore: { label: "Demo", href: "https://sergiomsrs.github.io/MyRecipes/" },
    links: [{ label: "Code", href: "https://github.com/Sergiomsrs/MyRecipes" }],
    image: `${base}my-recipes.webp`,
    imageAlt: "Captura de pantalla del proyecto MyRecipes",
  },
  {
    n: "03",
    title: "MyClass360",
    summary:
      "Sistema integral para la gestión de alumnos, clases y tareas, con herramientas como generador de sopas de letras.",
    tech: "Angular · TypeScript · RxJS",
    explore: {
      label: "Demo",
      href: "https://sergiomsrs.github.io/MyClass360-AngularUI/",
    },
    links: [
      {
        label: "Code",
        href: "https://github.com/Sergiomsrs/MyClass360-AngularUI",
      },
    ],
    image: `${base}my-class-360-landing.webp`,
    imageAlt: "Captura de pantalla del proyecto MyClass360",
  },
  {
    n: "04",
    title: "TimeTrack",
    summary:
      "Sistema de control horario: registro de fichajes y supervisión para empleados y administradores.",
    tech: "Java · Spring Boot · React",
    explore: {
      label: "Code",
      href: "https://github.com/Sergiomsrs/timetrack-ui",
    },
    links: [
      { label: "UI", href: "https://github.com/Sergiomsrs/timetrack-ui" },
      { label: "API", href: "https://github.com/Sergiomsrs/timetrack-api" },
    ],
    image: `${base}timeTrack.webp`,
    imageAlt: "Captura de pantalla del proyecto TimeTrack",
  },
  {
    n: "05",
    title: "Training App",
    summary:
      "Plataforma en desarrollo para la creación y gestión de entrenamientos con análisis de datos de usuarios.",
    tech: "React · Java · Spring Boot · MySQL · MongoDB",
    explore: {
      label: "Code",
      href: "https://github.com/Sergiomsrs/app-training-v.0",
    },
    links: [
      {
        label: "Workout API",
        href: "https://github.com/Sergiomsrs/Wod-Api--Shared",
      },
      {
        label: "Users API",
        href: "https://github.com/Sergiomsrs/Usersapp-Api--Shared",
      },
    ],
    image: `${base}principal.webp`,
    imageAlt: "Captura de pantalla del proyecto Training App",
  },
];
---

<div class="animate-on-scroll">
  {PROJECTS.map((project) => <ProjectEntry {...project} />)}
</div>

<div
  id="lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Imagen ampliada del proyecto"
  aria-hidden="true"
  tabindex="-1"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute right-4 top-4 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white transition-colors duration-200 hover:bg-black/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    aria-label="Cerrar imagen ampliada"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  <img
    id="lightbox-img"
    class="max-h-[85vh] max-w-[92vw] rounded-sm object-contain shadow-2xl"
    alt=""
  />
</div>

<script is:inline>
  function initLightbox() {
    if (document._lightboxBound) return;
    document._lightboxBound = true;

    const close = () => {
      const overlay = document.getElementById("lightbox");
      if (overlay) {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        overlay.setAttribute("aria-hidden", "true");
      }
      document.body.classList.remove("overflow-hidden");
    };

    const open = (img) => {
      const overlay = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const closeBtn = document.getElementById("lightbox-close");
      if (!overlay || !lightboxImg) return;

      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt || "";
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      overlay.setAttribute("aria-hidden", "false");
      document.body.classList.add("overflow-hidden");
      closeBtn?.focus();
    };

    document.addEventListener("click", (event) => {
      const overlay = document.getElementById("lightbox");

      if (event.target.closest("#lightbox-close")) {
        close();
        return;
      }

      if (overlay && event.target === overlay) {
        close();
        return;
      }

      const trigger = event.target.closest("[data-lightbox]");
      const img = trigger?.querySelector("img");
      if (img) open(img);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
  }

  initLightbox();
  document.addEventListener("astro:page-load", initLightbox);
</script>
