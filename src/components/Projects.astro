---
const { title, description, image, imageAlt } = Astro.props
---

<article class="group cursor-default">
  <div class="space-y-3">
    <div class="flex items-start gap-3">
      <div class="w-0.5 bg-primary-600 dark:bg-primary-400 rounded-full origin-top scale-y-0 group-hover:scale-y-100 transition-transform duration-300 ease-out self-stretch"></div>
      <h3 class="text-xl font-semibold text-surface-900 dark:text-surface-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-all duration-300 group-hover:translate-x-1">
        {title}
      </h3>
    </div>
    <p class="text-surface-600 dark:text-surface-400 leading-relaxed text-pretty transition-all duration-300 group-hover:translate-x-1 group-hover:text-surface-700 dark:group-hover:text-surface-300">
      {description}
    </p>
    {
      image && (
        <div class="relative overflow-hidden rounded-xl border border-surface-200 dark:border-surface-700 mt-4">
          <img
            loading="lazy"
            class="w-full aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
            src={image}
            alt={imageAlt || `Captura de pantalla del proyecto ${title}`}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
        </div>
      )
    }
  </div>
</article>
