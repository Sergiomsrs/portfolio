---
interface Link {
  label: string
  href: string
}

interface Props {
  n: string
  title: string
  summary: string
  tech: string
  explore: Link
  links?: Link[]
  image?: string
  imageAlt?: string
}

const { n, title, summary, tech, explore, links = [], image, imageAlt } =
  Astro.props
---

<article
  class="group grid gap-x-8 gap-y-4 border-t border-line/10 py-9 first:border-t-0 first:pt-0 md:grid-cols-[3rem_1fr_14rem] md:items-start"
>
  <p
    class="font-mono text-xs tracking-[0.1em] text-faint transition-colors duration-300 group-hover:text-accent md:pt-1.5"
    aria-hidden="true"
  >
    {n}
  </p>

  <div class="min-w-0">
    <h3
      class="text-xl font-semibold tracking-tight text-foreground transition-transform duration-300 group-hover:translate-x-0.5 md:text-2xl"
    >
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-muted md:text-base">
      {summary}
    </p>
    <p
      class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-faint"
    >
      {tech}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <a
        href={explore.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover transition-colors duration-200"
      >
        Explore project
        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[11px] uppercase tracking-[0.12em] text-faint hover:text-accent transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>

  {
    image && (
      <button
        type="button"
        data-lightbox
        class="block overflow-hidden rounded-sm border border-line/10"
        aria-label={`Ampliar imagen de ${title}`}
      >
        <img
          loading="lazy"
          class="block aspect-video w-full object-cover transition-all duration-500 group-hover:scale-[1.03] group-hover:opacity-100 group-hover:saturate-100 md:opacity-70 md:saturate-[0.85]"
          src={image}
          alt={imageAlt || `Captura de pantalla del proyecto ${title}`}
        />
      </button>
    )
  }
</article>
