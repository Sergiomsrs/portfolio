---
interface Props {
  title: string
  description: string
  link?: string
  date: string
}

const { title, description, link, date } = Astro.props
---

<div class="relative pl-12 md:pl-20">
  {/* Punto del timeline */}
  <div class="absolute left-2.5 md:left-6.5 top-1.5 w-3 h-3 rounded-full bg-primary-600 border-4 border-surface-50 dark:border-surface-950 shadow-sm" />
  
  <div class="space-y-2">
    <time class="inline-block text-xs font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wider">
      {date}
    </time>
    <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-100">
      {title}
    </h3>
    <p class="text-surface-600 dark:text-surface-400 leading-relaxed">
      {description}
    </p>
  </div>
</div>
