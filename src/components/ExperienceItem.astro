---
interface Props {
  title: string
  description: string
  date: string
}

const { title, description, date } = Astro.props
---

<div
  class="grid gap-1.5 py-7 md:grid-cols-[10rem_1fr] md:gap-10 md:py-8"
>
  <time
    class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint md:pt-1.5"
  >
    {date}
  </time>
  <div>
    <h3 class="text-base font-semibold text-foreground md:text-lg">
      {title}
    </h3>
    <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">
      {description}
    </p>
  </div>
</div>
