---
const currentYear = new Date().getFullYear()

const LINKS = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/sergio-mendez-soler-03902aa5/",
  },
  { label: "GitHub", href: "https://github.com/sergiomsrs" },
  { label: "Email", href: "mailto:sergiomsrs@gmail.com" },
]
---

<footer class="border-t border-line/10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-5 px-6 py-8 sm:flex-row sm:items-center lg:px-8"
  >
    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
      © {currentYear} Sergio Méndez — Based in Spain
    </p>
    <nav class="flex items-center gap-6" aria-label="Enlaces legales y redes">
      {
        LINKS.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={
              link.href.startsWith("http") ? "noopener noreferrer" : undefined
            }
            class="text-[13px] text-muted hover:text-accent transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
